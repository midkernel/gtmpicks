{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GTM Picks catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "resources"],
  "properties": {
    "version": { "const": 1 },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "description", "category", "format"],
        "properties": {
          "id": { "type": "string", "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
          "description": { "type": "string", "minLength": 1, "maxLength": 320 },
          "category": { "enum": ["gtm", "search", "agents"] },
          "format": { "type": "string", "minLength": 1, "maxLength": 32 }
        }
      }
    }
  }
}
